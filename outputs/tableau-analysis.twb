        <calculation class='tableau' formula='IF [What country do you live in?] = &quot;United States&quot;&#10;THEN [What is your annual base salary?]&#10;ELSEIF [What country do you live in?] = &quot;United Kingdom&quot;&#10;THEN [What is your annual base salary?] / 0.7&#10;ELSEIF [What country do you live in?] = &quot;India&quot;&#10;THEN [What is your annual base salary?] / 19.90&#10;ELSEIF [What country do you live in?] = &quot;Canada&quot;&#10;THEN [What is your annual base salary?] / 1.2&#10;ELSEIF [What country do you live in?] = &quot;Germany&quot;&#10;THEN [What is your annual base salary?] / 0.72&#10;ELSEIF [What country do you live in?] = &quot;France&quot;&#10;THEN [What is your annual base salary?] / 0.7&#10;ELSEIF [What country do you live in?] = &quot;Sweden&quot;&#10;THEN [What is your annual base salary?] / 8.59&#10;END' />
