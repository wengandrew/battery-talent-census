          <datasource-dependencies datasource='federated.187axip0wc8r91171ideq0bvml6h'>
            <column caption='RUNNING_SUM(COUNT([How many years have you been with the comp...' datatype='real' name='[Calculation_2140335754796527633]' role='measure' type='quantitative' user:unnamed='Company Years'>
              <calculation class='tableau' formula='RUNNING_SUM(COUNT([How many years have you been with the company?]) / TOTAL(COUNT([How many years have you been with the company?])))'>
                <table-calc ordering-type='Rows' />
