        <calculation class='tableau' formula='IF INT([What is your ZIP code or postal code?]) &gt;= 90001 AND INT([What is your ZIP code or postal code?])  &lt;= 96162&#10;THEN [What is your annual base salary?]/1.125&#10;ELSEIF INT([What is your ZIP code or postal code?]) &gt;= 48001 AND INT([What is your ZIP code or postal code?])  &lt;= 49971&#10;THEN [What is your annual base salary?] /0.941&#10;ELSEIF INT([What is your ZIP code or postal code?]) &gt;= 1001 AND INT([What is your ZIP code or postal code?])  &lt;= 5544&#10;THEN [What is your annual base salary?] /1.082&#10;ELSEIF INT([What is your ZIP code or postal code?]) &gt;= 10000 AND INT([What is your ZIP code or postal code?])  &lt;= 14000&#10;THEN [What is your annual base salary?] /1.072&#10;ELSEIF INT([What is your ZIP code or postal code?]) &gt;= 73301 AND INT([What is your ZIP code or postal code?])  &lt;= 88595&#10;THEN [What is your annual base salary?] /0.971&#10;END' />
      </column>
