      <column aggregation='None' datatype='integer' name='[Bonus Income (bin)]' role='dimension' type='quantitative'>
        <calculation class='bin' decimals='4' formula='[Calculation_2140335754794655760]' peg='0' size='10000' />
      </column>
      <column aggregation='Sum' caption='By the time I graduate, I will have learned the skills needed to find a job1' datatype='integer' name='[By the time I graduate, I will have learned the skills needed to find a job]' role='dimension' type='ordinal' />
      <column caption='Bonus Income' datatype='integer' name='[Calculation_2140335754794655760]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[What is your total income over the past 12 months?] - [What is your annual base salary?]' />
      </column>
      <column caption='What is your annual base salary (USD)?' datatype='real' name='[Calculation_441775007955492864]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [What country do you live in?] = &quot;United States&quot;&#10;THEN [What is your annual base salary?]&#10;ELSEIF [What country do you live in?] = &quot;United Kingdom&quot;&#10;THEN [What is your annual base salary?] * 1.24&#10;ELSEIF [What country do you live in?] = &quot;India&quot;&#10;THEN [What is your annual base salary?] * 0.012&#10;ELSEIF [What country do you live in?] = &quot;Canada&quot;&#10;THEN [What is your annual base salary?] * 0.69&#10;ELSEIF [What country do you live in?] = &quot;Germany&quot;&#10;THEN [What is your annual base salary?] * 1.03&#10;ELSEIF [What country do you live in?] = &quot;France&quot;&#10;THEN [What is your annual base salary?] * 1.03&#10;ELSEIF [What country do you live in?] = &quot;Sweden&quot;&#10;THEN [What is your annual base salary?] * 0.090&#10;END' />
      </column>
      <column caption='Age Group' datatype='string' name='[Calculation_441775008873664515]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [What is your age?] &lt;= 34&#10;THEN &quot;&lt;34&quot;&#10;ELSEIF ([What is your age?] &gt;34 AND [What is your age?] &lt; 55)&#10;THEN &quot;35-54&quot;&#10;ELSE &quot;55+&quot;&#10;END' />
      </column>
      <column caption='Avg Tenure' datatype='real' name='[Calculation_441775009251991556]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([How many years have you been with the company?])/COUNT([How many years have you been with the company?])' />
      </column>
